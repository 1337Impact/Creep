{
  "manifest_version": 3,
  "name": "Creep",
  "version": "1.0",
  "description": "AI helper that sits in the corner of your screen",
  "icons": {
    "16": "icons/owl.svg",
    "32": "icons/owl.svg",
    "48": "icons/owl.svg",
    "128": "icons/owl.svg"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.tsx"
      ]
    }
  ],
  "commands": {
    "toggle-chat-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle Creep chat panel"
    },
    "open-chat-panel-with-voice": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Open Creep chat panel with voice recording"
    }
  }
}