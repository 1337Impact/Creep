# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, for GPT-4o models)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Cursor bridge server URL (optional, defaults to http://localhost:8000).
# VITE_CURSOR_SERVER_URL=http://localhost:8000

# Cursor API key, read by the local bridge server (server/main.py) from this file.
# Get it from https://cursor.com/dashboard/api
CURSOR_API_KEY=your_cursor_api_key_here
# Optional Cursor bridge overrides:
# CREEP_AGENT_CWD=/path/to/repo
# CREEP_AGENT_MODEL=composer-2.5
# .cursor settings layers to load (skills/rules/MCP). Default loads your global
# ~/.cursor skills (e.g. use-mopedia) plus the workspace .cursor.
# CREEP_AGENT_SETTING_SOURCES=user,project
